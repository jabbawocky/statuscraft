{
  "name": "statuscraft",
  "version": "2.13.0",
  "description": "MCP server that checks the live status of major software services",
  "type": "module",
  "bin": {
    "statuscraft": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "status",
    "service-status",
    "uptime",
    "monitoring",
    "github-status",
    "aws-status",
    "openai-status",
    "statuspage",
    "devops",
    "developer-tools"
  ],
  "author": "Mat Carter",
  "license": "MIT",
  "homepage": "https://github.com/jabbawocky/statuscraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabbawocky/statuscraft.git"
  },
  "bugs": {
    "url": "https://github.com/jabbawocky/statuscraft/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
